pipeline {
    agent any
    stages {
        stage('1. Checkout') { steps { checkout scm } }

        stage('2. Setup') {
            steps { bat 'docker run --rm node:20-alpine node -v' }
        }

        stage('3. Build Rapide') {
            steps {
                // On nomme l'image différemment pour ne pas mélanger
                bat "docker build -t movies-pr:${BUILD_NUMBER} ."
            }
        }

        stage('4. Run Test') {
            steps {
                bat "docker rm -f pr-container || exit 0"
                // On utilise un port différent (3001) pour ne pas bloquer le dev (3000)
                bat "docker run -d -p 3001:80 --name pr-container movies-pr:${BUILD_NUMBER}"
            }
        }

        stage('5. Smoke Test') {
            steps {
                sleep 5
                bat "curl -I http://localhost:3001"
            }
        }

        stage('6. Cleanup') {
            steps { bat "docker rm -f pr-container" }
        }
    }
}
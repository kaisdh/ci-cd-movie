pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
       
        stage('Setup') {
            agent { docker { image 'node:18-alpine' } }
            steps { sh 'npm install' }
        }
        
        stage('Build') {
            steps {
                sh 'docker build -t movies-pr:${BUILD_NUMBER} .'
            }
        }
         
        stage('Smoke Test') {
            steps {
                
                sh 'docker run -d -p 3001:80 --name pr-container movies-pr:${BUILD_NUMBER}'
               
                sh 'chmod +x smoke_test.sh'
                sh './smoke_test.sh'
            }
        }
    }
    post {
        always { sh 'docker rm -f pr-container || true' }
    }
}
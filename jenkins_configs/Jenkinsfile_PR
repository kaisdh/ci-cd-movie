// jenkins_configs/Jenkinsfile_PR

pipeline {
    agent any
    
    environment {
        DOCKER_IMAGE = 'movie-react-app-pr'
        TEST_PORT = 8080 
    }

    stages {
        stage('Checkout & Setup') {
            steps {
                cleanWs()
                checkout scm
                sh 'npm install'
            }
        }

        stage('Build & Test Rapide') {
            steps {
                parallel(
                    "Node 18 Build": { sh 'docker run --rm -v $(pwd):/app -w /app node:18-alpine npm run build' },
                    "Code Linting": { sh 'echo "Running quick Linting..."' }
                )
            }
        }

        stage('Run Docker & Smoke Test') {
            steps {
                sh "docker build -t ${DOCKER_IMAGE} ."
                sh "docker run -d -p ${TEST_PORT}:80 --name ${DOCKER_IMAGE}-${env.BUILD_ID} ${DOCKER_IMAGE}"
                sh './smoke_test.sh'
            }
        }

        stage('Archive Logs') {
            steps {
                // Seulement archivage des logs de test, pas des livrables
                archiveArtifacts artifacts: 'smoke_test.sh', fingerprint: true
            }
        }
    }
    
    post {
        always {
            sh "docker rm -f ${DOCKER_IMAGE}-${env.BUILD_ID} || true"
        }
    }
}
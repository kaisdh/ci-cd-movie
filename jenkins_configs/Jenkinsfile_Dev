// jenkins_configs/Jenkinsfile_Dev

pipeline {
    agent any
    
    environment {
        DOCKER_IMAGE = 'movie-react-app-dev'
        TEST_PORT = 8080 
    }

    stages {
        stage('Checkout, Setup & Build Parallel') {
            steps {
                cleanWs()
                checkout scm
                sh 'npm install'
                parallel(
                    "Node 18 Build": { sh 'docker run --rm -v $(pwd):/app -w /app node:18-alpine npm run build' },
                    "Node 20 Build": { sh 'docker run --rm -v $(pwd):/app -w /app node:20-alpine npm run build' }
                )
            }
        }

        stage('Run Docker & Smoke Test') {
            steps {
                sh "docker build -t ${DOCKER_IMAGE} ."
                sh "docker run -d -p ${TEST_PORT}:80 --name ${DOCKER_IMAGE}-${env.BUILD_ID} ${DOCKER_IMAGE}"
                sh './smoke_test.sh'
            }
        }

        stage('Archive Artifacts') {
            steps {
                // Archivage des artefacts de build et des logs
                archiveArtifacts artifacts: 'build/index.html, smoke_test.sh', fingerprint: true
            }
        }
    }
    
    post {
        always {
            sh "docker rm -f ${DOCKER_IMAGE}-${env.BUILD_ID} || true"
        }
    }
}
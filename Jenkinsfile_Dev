pipeline {
    agent any
    
    environment {
        APP_NAME = "react-film-app"
        DOCKER_TAG = "dev-${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup') {
            steps {
                echo 'Setup environment...'
            }
        }

        stage('Build') {
            parallel {
                stage('Build Docker Image') {
                    steps {
                        sh "docker build -t ${APP_NAME}:${DOCKER_TAG} ."
                    }
                }
                stage('Linting') {
                    steps {
                        echo 'Simulation Analyse du code (Linting)...'
                    }
                }
            }
        }

        stage('Run (Docker)') {
            steps {
                // Nettoyage préventif
                sh "docker rm -f ${APP_NAME}-dev || true"
                // Lancement du conteneur
                sh "docker run -d -p 3001:80 --name ${APP_NAME}-dev ${APP_NAME}:${DOCKER_TAG}"
                sleep 10
            }
        }

        stage('Smoke Test') {
            steps {
                script {
                    try {
                        sh "curl -f http://localhost:3001"
                        echo "Test Passed sur DEV"
                    } catch (Exception e) {
                        error("Smoke Test Failed sur DEV")
                    }
                }
            }
        }

        stage('Archive Artifacts') {
            steps {
                sh "docker logs ${APP_NAME}-dev > dev-build.log"
                archiveArtifacts artifacts: 'dev-build.log'
            }
        }
    }

    post {
        always {
            // CORRECTION ICI : Pas de 'stage', juste les commandes
            echo 'Nettoyage...'
            sh "docker stop ${APP_NAME}-dev || true"
            sh "docker rm ${APP_NAME}-dev || true"
        }
    }
}
pipeline {
    agent any
    stages {
        stage('1. Checkout') { steps { checkout scm } }
        
        stage('2. Setup & Parallel') {
            parallel {
                stage('Node 18') { steps { bat 'docker run --rm node:18-alpine node -v' } }
                stage('Node 20') { steps { bat 'docker run --rm node:20-alpine node -v' } }
            }
        }

        stage('3. Build Docker') {
            steps { bat "docker build -t movies-dev:${BUILD_NUMBER} ." }
        }

        stage('4. Run Container') {
            steps {
                bat "docker rm -f dev-container || exit 0"
                bat "docker run -d -p 3000:80 --name dev-container movies-dev:${BUILD_NUMBER}"
            }
        }

        stage('5. Smoke Test') {
            steps {
                sleep 5
                bat "curl -I http://localhost:3000"
            }
        }

        stage('6. Cleanup') {
            steps { bat "docker rm -f dev-container" }
        }

        // --- C'EST ICI QUE CA SE JOUE ---
        stage('7. Archive Artifacts') {
            steps {
                // Cette ligne dit : "Sauvegarde le Dockerfile et tous les Jenkinsfiles"
                archiveArtifacts artifacts: 'Dockerfile, Jenkinsfile*', allowEmptyArchive: true
            }
        }
    }
}

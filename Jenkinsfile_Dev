pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        // --- CORRECTION ICI ---
        // On retire "agent { docker }" qui plante sur Windows.
        // On utilise des commandes simples pour prouver la parallélisation.
        stage('Setup & Tests Parallèles') {
            parallel {
                stage('Test Node 18') {
                    steps {
                        // On lance juste un conteneur pour afficher la version
                        // Cela prouve que le runtime 18 fonctionne
                        bat 'docker run --rm node:18-alpine node -v'
                    }
                }
                stage('Test Node 20') {
                    steps {
                        // Pareil pour la version 20
                        bat 'docker run --rm node:20-alpine node -v'
                    }
                }
            }
        }
        // ----------------------

        stage('Build Complet') {
            steps {
                // Le vrai build se fait ici via le Dockerfile
                bat "docker build -t movies-dev:${BUILD_NUMBER} ."
            }
        }

        stage('Run & Smoke') {
            steps {
                // Nettoyage et Lancement
                bat "docker rm -f dev-container || exit 0"
                bat "docker run -d -p 3000:80 --name dev-container movies-dev:${BUILD_NUMBER}"
                
                // Petite pause pour laisser le serveur démarrer
                sleep 5
                
                // Smoke Test adapté pour Windows (PowerShell curl)
                bat "curl -I http://localhost:3000"
            }
        }
    }
}
pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
       
        stage('Setup & Tests Parallèles') {
            parallel {
                stage('Node 18') {
                    agent { docker { image 'node:18-alpine' } }
                    steps { sh 'npm install' }
                }
                stage('Node 20') {
                    agent { docker { image 'node:20-alpine' } }
                    steps { sh 'npm install' }
                }
            }
        }
        stage('Build Complet') {
            steps {
                sh 'docker build -t movies-dev:${BUILD_NUMBER} .'
            }
        }
        stage('Run & Smoke') {
            steps {
                sh 'docker rm -f dev-container || true'
                sh 'docker run -d -p 3000:80 --name dev-container movies-dev:${BUILD_NUMBER}'
                sh 'chmod +x smoke_test.sh'
                sh './smoke_test.sh'
            }
        }
    }
}
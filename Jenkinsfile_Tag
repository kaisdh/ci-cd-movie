pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Build Versionné') {
            steps {
                // On utilise le nom du TAG (ex: v1.0.0) 
                sh "docker build -t movies-prod:${TAG_NAME} ."
            }
        }
        stage('Archivage') {
            steps {
                // On crée un rapport de build
                sh "echo 'Build version ${TAG_NAME} reussi' > rapport.txt"
                // Exigence : Archiver les artefacts 
                archiveArtifacts artifacts: 'rapport.txt', allowEmptyArchive: true
            }
        }
    }
}
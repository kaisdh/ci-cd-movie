pipeline {
    agent any
    
    stages {
        // --- 1. CHECKOUT ---
        stage('1. Checkout') { 
            steps { 
                echo "Récupération du code..."
                checkout scm 
            } 
        }

        // --- 2. SETUP (NOUVEAU) ---
        stage('2. Setup & Install') {
            steps { 
                echo "Préparation de l'environnement..."
                // Simulation d'une étape d'installation si votre Dockerfile ne gère pas tout
                // Ici, on vérifie juste que Node est accessible via Docker
                bat 'docker run --rm node:20-alpine node -v' 
            }
        }
        
        // --- 3. BUILD VERSIONNÉ ---
        stage('3. Build Versionné') {
            steps {
                script {
                    // Si TAG_NAME est vide (test manuel), on met 'v-test-X'
                    def version = env.TAG_NAME ?: "v-test-${BUILD_NUMBER}"
                    env.RELEASE_VERSION = version // On enregistre la version pour les étapes suivantes
                    
                    // Exigence : Dockerisation propre
                    bat "docker build -t movies-release:${env.RELEASE_VERSION} ."
                    bat "echo Build de la version ${env.RELEASE_VERSION} réussi > rapport_build.txt"
                }
            }
        }

        // --- 4. RUN (NOUVEAU) ---
        stage('4. Run Docker (Test Local)') {
            steps {
                scrip
                    bat "docker rm -f release-container || exit 0" 
                   
                    bat "docker run -d -p 3002:80 --name release-container movies-release:${env.RELEASE_VERSION}"
                }
            }
        }

        
        stage('5. Smoke Test') {
            steps {
                echo "Vérification du service..."
                sleep 5
                
                bat "curl -I http://localhost:3002 > smoke_test_result.log"
                
                bat 'type smoke_test_result.log && find /C:"200 OK" smoke_test_result.log'
            }
        }

        
        stage('6. Archive Artifacts') {
            steps {
                echo "Archivage des livrables de la version ${env.RELEASE_VERSION}..."
                
                /
                archiveArtifacts artifacts: 'rapport_build.txt, smoke_test_result.log', allowEmptyArchive: true
                
                
                bat 'tar -czf release-${RELEASE_VERSION}.tar.gz build/'
                archiveArtifacts artifacts: 'release-${RELEASE_VERSION}.tar.gz', fingerprint: true
            }
        }
     
        stage('7. Cleanup') {
            steps { 
                echo "Nettoyage des conteneurs et images temporaires..."
                bat "docker rm -f release-container"
                
        }
    }
}
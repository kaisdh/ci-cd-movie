// jenkins_configs/Jenkinsfile_Tag

pipeline {
    agent any
    
    environment {
        APP_NAME = 'movie-react-app'
        DOCKER_IMAGE = "${APP_NAME}:${env.TAG_NAME ?: env.BUILD_ID}"
        TEST_PORT = 8080 
    }

    stages {
        stage('Checkout, Setup & Build Parallel') {
            steps {
                cleanWs()
                checkout scm
                sh 'npm install'
                parallel(
                    "Node 18 Build": { sh 'docker run --rm -v $(pwd):/app -w /app node:18-alpine npm run build' },
                    "Node 20 Build": { sh 'docker run --rm -v $(pwd):/app -w /app node:20-alpine npm run build' }
                )
            }
        }

        stage('Run Docker & Smoke Test') {
            steps {
                sh "docker build -t ${DOCKER_IMAGE} ."
                sh "docker run -d -p ${TEST_PORT}:80 --name ${APP_NAME}-${env.BUILD_ID} ${DOCKER_IMAGE}"
                sh './smoke_test.sh'
            }
        }

        stage('Archive Release Artifacts') {
            steps {
                echo "--- PIPELINE DE RELEASE: Archivage complet pour la version ${env.TAG_NAME} ---"
                // ARCHIVAGE OBLIGATOIRE du livrable
                sh 'tar -czf release-${TAG_NAME}.tar.gz build/'
                archiveArtifacts artifacts: '*.tar.gz, smoke_test.sh', fingerprint: true
            }
        }
    }
    
    post {
        always {
            sh "docker rm -f ${APP_NAME}-${env.BUILD_ID} || true"
        }
        success {
            echo "✅ RELEASE ${env.TAG_NAME} PRÊTE À ÊTRE DÉPLOYÉE !"
        }
    }
}